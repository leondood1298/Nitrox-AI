<UserControl
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Nitrox.Launcher.Views.UpdatesView"
    x:DataType="vm:UpdatesViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:Nitrox.Launcher.Models.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:Nitrox.Launcher.Models.Services"
    xmlns:vm="clr-namespace:Nitrox.Launcher.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:designer="clr-namespace:Nitrox.Launcher.ViewModels.Designer">
    <Design.DataContext>
        <designer:DesignUpdatesViewModel />
    </Design.DataContext>
    <ScrollViewer
        Classes="main">
        <StackPanel
            Background="{DynamicResource BrandWhite}"
            Classes="viewPadding"
            Spacing="23">

            <TextBlock Classes="header" Text="Updates" />

            <Border
                Background="{DynamicResource BrandPanelBackground}"
                CornerRadius="12"
                Padding="22">
                <StackPanel Spacing="10">
                    <controls:RecolorImage
                        Height="56"
                        HorizontalAlignment="Center"
                        Source="/Assets/Images/nitrox-icon.ico"
                        Width="56" />

                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Nitrox-AI build"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            FontSize="14"
                            FontWeight="Normal"
                            TextAlignment="Center"
                            TextWrapping="Wrap">
                            <Run Text="This build does not check for updates. Official Nitrox releases would replace it and cannot open its worlds. Version:" />
                            <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backups Section -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Text="Backups"
                        VerticalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button
                            Classes="icon"
                            Command="{Binding RefreshBackupsCommand}"
                            ToolTip.Tip="Refresh backups list">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="{DynamicResource BrandBlack}" />
                        </Button>
                        <Button
                            Classes="icon"
                            Command="{Binding OpenBackupsFolderCommand}"
                            ToolTip.Tip="Open backups folder">
                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                  Fill="{DynamicResource BrandBlack}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock
                    FontSize="12"
                    Opacity="0.7"
                    Text="Backups of the launcher made by earlier builds before an update. You can restore a previous version by extracting a backup manually." />

                <Border
                    Background="{DynamicResource BrandPanelBackground}"
                    CornerRadius="12"
                    Padding="16"
                    IsVisible="{Binding AvailableBackups.Count}">
                    <ItemsControl ItemsSource="{Binding AvailableBackups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:BackupInfo">
                                <Border
                                    Background="{DynamicResource BrandWhite}"
                                    CornerRadius="8"
                                    Padding="12">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding FileName}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.7">
                                                    <Run Text="Version:" />
                                                    <Run Text="{Binding Version}" />
                                                </TextBlock>
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.7">
                                                    <Run Text="Size:" />
                                                    <Run Text="{Binding SizeDisplay}" />
                                                </TextBlock>
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.7"
                                                    IsVisible="{Binding IncludesSaves}">
                                                    <Run Text="(includes saves)" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.5"
                                                Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Classes="primary"
                                            Command="{Binding $parent[ItemsControl].((vm:UpdatesViewModel)DataContext).RestoreBackupCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"
                                            ToolTip.Tip="Restore this backup"
                                            VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Text="Restore" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Classes="abort"
                                            Command="{Binding $parent[ItemsControl].((vm:UpdatesViewModel)DataContext).DeleteBackupCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6"
                                            ToolTip.Tip="Delete this backup"
                                            VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Text="Delete" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock
                    FontSize="14"
                    FontStyle="Italic"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !AvailableBackups.Count}"
                    Opacity="0.5"
                    Text="No backups available" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
